bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_java", version = "9.1.0")
bazel_dep(name = "rules_jvm_external", version = "6.7")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "33.4", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_scala", version = "7.2.6")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "org.projectlombok:lombok:1.18.46",
        "org.apache.commons:commons-lang3:3.17.0",
        "commons-codec:commons-codec:1.22.1",
        "org.apache.commons:commons-csv:1.10.0",
        "com.fazecast:jSerialComm:2.11.4",
        "com.google.guava:guava:32.0.1-jre",
        "com.google.truth:truth:1.4.5",
        "com.jayway.jsonpath:json-path:3.0.0",
        "javax.usb:usb-api:1.0.2",
        "junit:junit:4.13.2",
        "org.usb4java:usb4java:1.3.0",
        "org.usb4java:usb4java-javax:1.3.0",
        "com.formdev:flatlaf:3.4.1",
        "org.exbin.bined:bined-core:0.2.2",
        "org.exbin.bined:bined-swing:0.2.2",
        "org.exbin.auxiliary:binary_data:0.2.2",
        "org.exbin.auxiliary:binary_data-array:0.2.2",
        "io.github.globaltcad:swing-tree:0.24.1",
        "io.reactivex.rxjava3:rxjava:3.1.10",
        "io.github.globaltcad:sprouts:2.7.0",
        "org.mockito:mockito-core:5.23.0",
        "net.bytebuddy:byte-buddy:1.17.7",
        "net.bytebuddy:byte-buddy-agent:1.17.7",
        "org.objenesis:objenesis:3.3",
        "org.slf4j:slf4j-simple:2.0.17",
        "io.kaitai:kaitai-struct-runtime:0.11",
        "io.kaitai:kaitai-struct-compiler_2.13:0.11",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")

scala_config = use_extension(
    "@rules_scala//scala/extensions:config.bzl",
    "scala_config",
)
scala_config.settings(scala_version = "2.13.18")

scala_deps = use_extension(
    "@rules_scala//scala/extensions:deps.bzl",
    "scala_deps",
)
scala_deps.scala()
