package(default_visibility = ["//visibility:public"])

FORMATS = [
    "acornadfs",
    "acorndfs",
    "aeslanier",
    "agat",
    "amiga",
    "ampro",
    "apple2",
    "atarist",
    "bk",
    "brother",
    "commodore",
    "eco1",
    "epsonpf10",
    "f85",
    "fb100",
    "_global_options",
    "hplif",
    "ibm",
    "icl30",
    "juku",
    "mac",
    "micropolis",
    "ms2000",
    "mx",
    "n88basic",
    "northstar",
    "psos",
    "rolandd20",
    "rx50",
    "smaky6",
    "tartu",
    "ti99",
    "tids990",
    "tiki",
    "victor9k",
    "zilogmcz",
]

genrule(
    name = "formats",
    srcs = ["%s.textpb" % f for f in FORMATS],
    outs = ["formats/%s.bin" % f for f in FORMATS] + ["formats/names.txt"],
    tools = ["//java/com/cowlark/fluxengine/buildtools:protoencode"],
    cmd = " && ".join([
        "$(location //java/com/cowlark/fluxengine/buildtools:protoencode) " +
        "$(location %s.textpb) $(location formats/%s.bin)" % (f, f)
        for f in FORMATS
    ]) + " && printf '%%s\\n' %s > $(location formats/names.txt)" % " ".join(FORMATS),
)

filegroup(
    name = "formats_files",
    srcs = ["formats/%s.bin" % f for f in FORMATS] + ["formats/names.txt"],
)
