load("@rules_java//java:defs.bzl", "java_binary", "java_library")

package(default_visibility = ["//visibility:public"])

java_library(
    name = "mkdoclib",
    srcs = [
        "MkDoc.java",
        "MkDocIndex.java",
    ],
    deps = [
        "//java/com/cowlark/fluxengine/config:config_java_proto",
        "//java/com/cowlark/fluxengine/data",
        "//java/com/cowlark/fluxengine/vfs:vfs_java_proto",
        "@maven//:com_google_guava_guava",
    ],
)

java_binary(
    name = "mkdoc",
    main_class = "com.cowlark.fluxengine.buildtools.MkDoc",
    runtime_deps = [":mkdoclib"],
)

java_binary(
    name = "mkdocindex",
    main_class = "com.cowlark.fluxengine.buildtools.MkDocIndex",
    runtime_deps = [":mkdoclib"],
)

java_library(
    name = "encodedecodetest",
    srcs = ["EncodeDecodeTest.java"],
    deps = [
        "//java/com/cowlark/fluxengine/cli",
        "//java/com/cowlark/fluxengine/core",
        "@maven//:com_google_guava_guava",
    ],
)

java_binary(
    name = "encodedecodetest_bin",
    main_class = "com.cowlark.fluxengine.buildtools.EncodeDecodeTest",
    runtime_deps = [":encodedecodetest"],
)
